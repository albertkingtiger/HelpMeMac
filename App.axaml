<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HelpMe.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- The colour pickers in Settings come from their own package, and that
         package carries its own control themes rather than relying on the
         Fluent theme above. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>

    <!-- The palette the whole window reads. AppTheme replaces these entries
         when the theme is changed in Settings, so every brush below follows
         without a control being rebuilt. -->
    <Style>
      <Style.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#181818"/>
        <SolidColorBrush x:Key="EditorBackground" Color="#111213"/>
        <SolidColorBrush x:Key="Surface" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="InputBackground" Color="#252526"/>
        <SolidColorBrush x:Key="Divider" Color="#303031"/>
        <SolidColorBrush x:Key="Foreground" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="Muted" Color="#9D9D9D"/>
        <SolidColorBrush x:Key="Accent" Color="#0078D4"/>
        <SolidColorBrush x:Key="Hover" Color="#2A2D2E"/>
        <SolidColorBrush x:Key="Selection" Color="#264F78"/>
        <SolidColorBrush x:Key="Error" Color="#F48771"/>
        <SolidColorBrush x:Key="ScrollThumb" Color="#505050"/>
        <SolidColorBrush x:Key="ScrollThumbHover" Color="#686868"/>
        <SolidColorBrush x:Key="ScrollThumbDrag" Color="#808080"/>
        <SolidColorBrush x:Key="ToggleChecked" Color="#203A50"/>
        <SolidColorBrush x:Key="Pressed" Color="#37373D"/>
        <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF"/>
      </Style.Resources>
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
    </Style>

    <!-- Compact, flat buttons: a 26 pixel row keeps four of them in a panel
         header without crowding the title. -->
    <Style Selector="Button">
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Foreground}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Pressed}"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}"/>
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Foreground}"/>
    </Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToggleChecked}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Foreground}"/>
    </Style>
    <Style Selector="ToggleButton:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- A start/stop control says what pressing it will do. -->
    <Style Selector="ToggleButton.startStop">
      <Setter Property="Content" Value="Start"/>
    </Style>
    <Style Selector="ToggleButton.startStop:checked">
      <Setter Property="Content" Value="Stop"/>
    </Style>
    <Style Selector="ToggleButton.sectionCollapse">
      <Setter Property="MinWidth" Value="46"/>
      <Setter Property="Content" Value="Hide"/>
    </Style>
    <Style Selector="ToggleButton.sectionCollapse:checked">
      <Setter Property="Content" Value="Show"/>
    </Style>

    <!-- The caption editors. A monospaced face keeps a corrected word the same
         width as the one it replaced, so the text does not reflow while it is
         being edited. -->
    <Style Selector="TextBox.editor">
      <Setter Property="Background" Value="{DynamicResource EditorBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="FontFamily" Value="Menlo,Monaco,Consolas,monospace"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionText}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBox.editor /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource EditorBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBox.settings">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="AcceptsReturn" Value="False"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.settings /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource EditorBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border.sectionHeader">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,0,5,0"/>
    </Style>
    <Style Selector="Border.sectionTab">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="0,2,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Padding" Value="0,0,10,0"/>
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource Divider}"/>
    </Style>
  </Application.Styles>
</Application>
