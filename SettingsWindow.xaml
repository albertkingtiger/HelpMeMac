<Window x:Class="HelpMe.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="490" Height="490"
        ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource Foreground}" FontFamily="Segoe UI" FontSize="13">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="1,1,1,1" MouseLeftButtonDown="Title_MouseLeftButtonDown">
      <DockPanel Margin="12,0,0,0">
        <Button Style="{StaticResource CloseButton}" DockPanel.Dock="Right" IsCancel="True" ToolTip="Close settings" AutomationProperties.Name="Close settings"/>
        <TextBlock Text="Settings" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="24,18,24,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="146"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.ColumnSpan="2" Text="CAPTIONS" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,20">
        <RadioButton x:Name="WhisperOption" Content="Whisper (offline)" GroupName="CaptionMethod" IsChecked="True"/>
        <TextBlock Text="Transcribe PC audio using the downloaded English model." Foreground="{StaticResource Muted}" Margin="23,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <TextBlock Grid.Row="2" Text="Chrome debug port" VerticalAlignment="Center" Margin="0,0,0,10"/>
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="ChromePortText" Style="{StaticResource SettingsInput}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>
      <TextBlock Grid.Row="3" Text="AI provider" VerticalAlignment="Center" Margin="0,0,0,10"/>
      <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ProviderCombo" Margin="0,0,0,10"/>
      <TextBlock Grid.Row="4" Text="Project" VerticalAlignment="Center" Margin="0,0,0,10"/>
      <TextBox Grid.Row="4" Grid.Column="1" x:Name="ProjectCombo" Style="{StaticResource SettingsInput}" Margin="0,0,0,10" ToolTip="Saved preference. Send uses the conversation already open in Chrome."/>
      <TextBlock Grid.Row="5" Text="Session" VerticalAlignment="Center"/>
      <TextBox Grid.Row="5" Grid.Column="1" x:Name="SessionCombo" Style="{StaticResource SettingsInput}" ToolTip="Saved preference. Send uses the conversation already open in Chrome."/>
      <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Send uses the conversation open in the selected provider's Chrome tab." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="24,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="Cancel" IsCancel="True" Background="{StaticResource InputBackground}" MinWidth="72" Margin="0,0,8,0"/>
        <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" MinWidth="72"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
