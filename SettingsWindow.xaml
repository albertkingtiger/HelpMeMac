<Window x:Class="HelpMe.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="490" Height="490"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#0B1220" FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="PC audio caption method" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
    <StackPanel Grid.Row="1" Margin="0,0,0,18">
      <RadioButton x:Name="WhisperOption" Content="Whisper (offline)" Foreground="#EDF2FC" FontSize="14" GroupName="CaptionMethod" IsChecked="True"/>
      <TextBlock Text="Uses the downloaded English model in Help Me!." Foreground="{StaticResource Muted}" Margin="20,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBlock Grid.Row="2" Text="Whisper is the only caption engine. This keeps the capture path independent of Windows caption services." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
      <TextBlock Text="Chrome debug port" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      <TextBox x:Name="ChromePortText" Width="90" Height="26" Margin="12,0,0,0" Padding="6,2" IsReadOnly="False"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
      <TextBlock Text="AI provider" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Width="120"/>
      <ComboBox x:Name="ProviderCombo" Width="190" Height="26" Foreground="#E9EFFB" Background="#141E30" BorderBrush="#2A3850" OverridesDefaultStyle="True">
        <ComboBox.Template>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
                <ContentPresenter Margin="8,0,28,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
              <ToggleButton Width="24" HorizontalAlignment="Right" Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                <TextBlock Text="▼" FontSize="9" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </ToggleButton>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" AllowsTransparency="True">
                <Border Width="190" Background="#141E30" BorderBrush="#2A3850" BorderThickness="1">
                  <ScrollViewer MaxHeight="160"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </ComboBox.Template>
        <ComboBox.ItemContainerStyle>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E9EFFB"/>
            <Setter Property="Background" Value="#141E30"/>
          </Style>
        </ComboBox.ItemContainerStyle>
      </ComboBox>
    </StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
      <TextBlock Text="Project" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Width="120"/>
      <TextBox x:Name="ProjectCombo" Width="190" Height="26" Padding="6,2" IsReadOnly="False" ToolTip="Saved preference. Send uses the conversation already open in Chrome."/>
    </StackPanel>
    <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
      <TextBlock Text="Session" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Width="120"/>
      <TextBox x:Name="SessionCombo" Width="190" Height="26" Padding="6,2" IsReadOnly="False" ToolTip="Saved preference. Send uses the conversation already open in Chrome."/>
    </StackPanel>
    <TextBlock Grid.Row="7" Text="Chrome opens ChatGPT and Claude tabs with the configured debug port. Help Me! closes the managed Chrome instance when it exits." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,12"/>
    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
      <Button Content="Save" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
