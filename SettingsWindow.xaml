<Window x:Class="HelpMe.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="580" Height="820"
        ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}" FontFamily="Segoe UI" FontSize="13">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1,1,1,1" MouseLeftButtonDown="Title_MouseLeftButtonDown">
      <DockPanel Margin="12,0,0,0">
        <Button Style="{StaticResource CloseButton}" DockPanel.Dock="Right" IsCancel="True" ToolTip="Close settings" AutomationProperties.Name="Close settings"/>
        <TextBlock Text="Settings" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,18,24,18">
        <TextBlock Text="THEME" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,12"/>
        <ComboBox x:Name="ThemeCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,18"/>
        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>
        <TextBlock Text="STARTUP" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,12"/>
        <CheckBox x:Name="StartWithWindowsCheck" Content="Start Help Me! when I sign in to Windows"/>
        <TextBlock Text="Help Me! always starts hidden in the system tray and keeps running there. Use the restore shortcut or the tray icon to show it, and tray Exit to quit."
                   Foreground="{DynamicResource Muted}" Margin="23,6,0,18" TextWrapping="Wrap"/>
        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>
        <TextBlock Text="CAPTIONS" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,12"/>
        <RadioButton x:Name="WhisperOption" Content="Whisper (offline)" GroupName="CaptionMethod" IsChecked="True"/>
        <TextBlock Text="Transcribe PC audio using the downloaded English model." Foreground="{DynamicResource Muted}" Margin="23,6,0,12" TextWrapping="Wrap"/>
        <RadioButton x:Name="WindowsCaptionsOption" Content="Windows 11 Live Captions" GroupName="CaptionMethod"/>
        <TextBlock Text="Read Windows Live Captions through accessibility. Windows may ask for initial setup." Foreground="{DynamicResource Muted}" Margin="23,6,0,20" TextWrapping="Wrap"/>

        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>
        <TextBlock Text="PAGES" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,12"/>
        <TextBlock Text="The AI and chat pages run inside Help Me! as panels 05 and 06. Sign in to them once there; they keep their sign-ins between runs."
                   Foreground="{DynamicResource Muted}" Margin="0,0,0,18" TextWrapping="Wrap"/>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="146"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="1" Text="AI provider" VerticalAlignment="Center" Margin="0,0,0,10"/>
          <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ProviderCombo" Margin="0,0,0,10"/>
          <TextBlock Grid.Row="2" Text="Project" VerticalAlignment="Center" Margin="0,0,0,10"/>
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="ProjectCombo" Style="{StaticResource SettingsInput}" Margin="0,0,0,10" ToolTip="Saved preference. Send uses the conversation already open in Chrome."/>
          <TextBlock Grid.Row="3" Text="Session" VerticalAlignment="Center" Margin="0,0,0,10"/>
          <TextBox Grid.Row="3" Grid.Column="1" x:Name="SessionCombo" Style="{StaticResource SettingsInput}" Margin="0,0,0,10" ToolTip="Saved preference. Send uses the conversation already open in Chrome."/>
          <TextBlock Grid.Row="4" Text="Send shortcut" VerticalAlignment="Center"/>
          <TextBox Grid.Row="4" Grid.Column="1" x:Name="SendShortcutText" Style="{StaticResource SettingsInput}"
                   IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="SendShortcutText_PreviewKeyDown"
                   ToolTip="Click here, then press the new shortcut"/>
          <TextBlock Grid.Row="5" Text="Restore shortcut" VerticalAlignment="Center" Margin="0,10,0,0"/>
          <TextBox Grid.Row="5" Grid.Column="1" x:Name="RestoreShortcutText" Style="{StaticResource SettingsInput}"
                   IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="RestoreShortcutText_PreviewKeyDown"
                   Margin="0,10,0,0" ToolTip="Global shortcut to show Help Me! from the tray"/>
          <TextBlock Grid.Row="6" Text="Send Selection" VerticalAlignment="Center" Margin="0,10,0,0"/>
          <TextBox Grid.Row="6" Grid.Column="1" x:Name="TelegramShortcutText" Style="{StaticResource SettingsInput}"
                   IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="TelegramShortcutText_PreviewKeyDown"
                   Margin="0,10,0,0" ToolTip="Sends the text selected in the AI answer to Telegram, or all of it when nothing is selected"/>
          <TextBlock Grid.Row="8" Text="Send answers to" VerticalAlignment="Center" Margin="0,10,0,0"/>
          <ComboBox Grid.Row="8" Grid.Column="1" x:Name="MessengerCombo" Margin="0,10,0,0"
                    ToolTip="Which chat app the panel 04 buttons post the AI answer to"/>
          <TextBlock Grid.Row="7" Text="All Send" VerticalAlignment="Center" Margin="0,10,0,0"/>
          <TextBox Grid.Row="7" Grid.Column="1" x:Name="TelegramAllShortcutText" Style="{StaticResource SettingsInput}"
                   IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="TelegramAllShortcutText_PreviewKeyDown"
                   Margin="0,10,0,0" ToolTip="Sends the whole AI answer to Telegram, ignoring any selection"/>
        </Grid>
        <TextBlock Text="Send uses the conversation already open in panel 05." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,14,0,14"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Auto-send, first message" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBox x:Name="AutoSendFirstCharsText" Style="{StaticResource SettingsInput}" Width="56"
                   ToolTip="Characters in the opening message, 20 to 4000"/>
          <TextBlock Text="characters, then" VerticalAlignment="Center" Margin="10,0,10,0"/>
          <TextBox x:Name="AutoSendNextCharsText" Style="{StaticResource SettingsInput}" Width="56"
                   ToolTip="Characters in each message after the first, 20 to 4000"/>
          <TextBlock Text="characters" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <TextBlock Text="Auto-send itself is the checkbox at the bottom of panel 04. While it is on, the opening message goes out as soon as the answer reaches the first size, so the reader sees something straight away, and the rest follow at the second size. Messages are whole sentences, so a size is a target to reach rather than a place to cut. The first message of each answer starts with a line of dashes. A code block is held back until it closes, and the rest of the answer follows when it ends. Text that has already gone out cannot be recalled if the AI rewrites it."
                   Foreground="{DynamicResource Muted}" Margin="0,8,0,20" TextWrapping="Wrap"/>

        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>
        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>
        <TextBlock Text="EDITOR APPEARANCE" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,12"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="146"/><ColumnDefinition Width="70"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Column="1" Text="Font size" Foreground="{DynamicResource Muted}" FontSize="11"/>
          <TextBlock Grid.Column="2" Text="Text color" Foreground="{DynamicResource Muted}" FontSize="11"/>
          <TextBlock Grid.Column="3" Text="Caret color" Foreground="{DynamicResource Muted}" FontSize="11"/>

          <TextBlock Grid.Row="1" Text="01  PC AUDIO" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="PcFontSizeText" Style="{StaticResource SettingsInput}" Width="56" HorizontalAlignment="Left" Margin="0,8,0,4"/>
          <Button Grid.Row="1" Grid.Column="2" x:Name="PcTextColorButton" Click="ColorButton_Click" Margin="0,8,8,4" ToolTip="Choose PC caption text color"/>
          <Button Grid.Row="1" Grid.Column="3" x:Name="PcCaretColorButton" Click="ColorButton_Click" Margin="0,8,0,4" ToolTip="Choose PC caption caret color"/>

          <TextBlock Grid.Row="2" Text="02  TRANSLATION" VerticalAlignment="Center"/>
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="TranslationFontSizeText" Style="{StaticResource SettingsInput}" Width="56" HorizontalAlignment="Left" Margin="0,4"/>
          <Button Grid.Row="2" Grid.Column="2" x:Name="TranslationTextColorButton" Click="ColorButton_Click" Margin="0,4,8,4" ToolTip="Choose translation text color"/>

          <TextBlock Grid.Row="3" Text="04  PROMPT" VerticalAlignment="Center"/>
          <TextBox Grid.Row="3" Grid.Column="1" x:Name="AnswerInputFontSizeText" Style="{StaticResource SettingsInput}" Width="56" HorizontalAlignment="Left" Margin="0,4"/>
          <Button Grid.Row="3" Grid.Column="2" x:Name="AnswerInputTextColorButton" Click="ColorButton_Click" Margin="0,4,8,4" ToolTip="Choose prompt text color"/>

          <TextBlock Grid.Row="4" Text="04  ANSWER" VerticalAlignment="Center"/>
          <TextBox Grid.Row="4" Grid.Column="1" x:Name="AnswerFontSizeText" Style="{StaticResource SettingsInput}" Width="56" HorizontalAlignment="Left" Margin="0,4"/>
          <Button Grid.Row="4" Grid.Column="2" x:Name="AnswerTextColorButton" Click="ColorButton_Click" Margin="0,4,8,4" ToolTip="Choose answer text color"/>
        </Grid>
        <TextBlock Text="Font sizes can be from 8 to 48." Foreground="{DynamicResource Muted}" FontSize="11" Margin="146,10,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="Cancel" IsCancel="True" Background="{DynamicResource InputBackground}" MinWidth="72" Margin="0,0,8,0"/>
        <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" MinWidth="72"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
